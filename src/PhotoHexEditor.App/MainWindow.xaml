<Window x:Class="PhotoHexEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PhotoHexEditor.App"
        mc:Ignorable="d"
        Title="Photo Hexadecimal Editor" Height="600" Width="900">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <Button x:Name="OpenButton" Content="Open..." Padding="8,4" Click="OpenButton_Click" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>
        <TextBox Text="{Binding HexDump, Mode=OneWay}"
                 FontFamily="Consolas"
                 FontSize="13"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 AcceptsReturn="True"
                 Margin="8" />
    </DockPanel>
</Window>
