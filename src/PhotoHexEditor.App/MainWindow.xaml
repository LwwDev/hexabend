<Window x:Class="PhotoHexEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PhotoHexEditor.App"
        mc:Ignorable="d"
        Title="Photo Hexadecimal Editor" Height="600" Width="1100">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
    </Window.InputBindings>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <Button x:Name="OpenButton" Content="Open..." Padding="8,4" Click="OpenButton_Click" />
            <Button x:Name="SaveButton" Content="Save As..." Padding="8,4" Margin="4,0,0,0" Click="SaveButton_Click" />
            <Button Content="Undo" Padding="8,4" Margin="8,0,0,0" Command="{Binding UndoCommand}" />
            <Button Content="Redo" Padding="8,4" Margin="4,0,0,0" Command="{Binding RedoCommand}" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,8,8">
            <TextBlock Text="Go to (hex):" VerticalAlignment="Center" />
            <TextBox x:Name="GoToOffsetBox" Width="70" Margin="4,0" VerticalAlignment="Center" />
            <Button Content="Go" Padding="6,2" Click="GoToOffsetButton_Click" />

            <TextBlock Text="Find:" VerticalAlignment="Center" Margin="16,0,0,0" />
            <TextBox x:Name="SearchBox" Width="120" Margin="4,0" VerticalAlignment="Center" />
            <CheckBox x:Name="SearchHexCheckBox" Content="hex" VerticalAlignment="Center" Margin="0,0,4,0" />
            <Button Content="Find Next" Padding="6,2" Click="FindNextButton_Click" />
            <TextBlock x:Name="SearchStatusText" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,8,8">
            <TextBlock Text="Selection (hex):" VerticalAlignment="Center" />
            <TextBox x:Name="SelectionStartBox" Width="70" Margin="4,0" VerticalAlignment="Center" />
            <TextBlock Text="to" VerticalAlignment="Center" />
            <TextBox x:Name="SelectionEndBox" Width="70" Margin="4,0" VerticalAlignment="Center" />
            <Button Content="Select" Padding="6,2" Click="SelectRangeButton_Click" />

            <Button Content="Randomize" Padding="6,2" Margin="16,0,0,0" Click="RandomizeButton_Click" />
            <Button Content="Invert" Padding="6,2" Margin="4,0,0,0" Click="InvertButton_Click" />

            <TextBlock Text="Fill:" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBox x:Name="FillValueBox" Width="30" Margin="4,0" VerticalAlignment="Center" Text="00" />
            <Button Content="Fill" Padding="6,2" Click="FillButton_Click" />

            <TextBlock Text="Shift:" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBox x:Name="ShiftDeltaBox" Width="40" Margin="4,0" VerticalAlignment="Center" Text="1" />
            <Button Content="Shift" Padding="6,2" Click="ShiftButton_Click" />

            <ComboBox x:Name="PresetComboBox"
                      Width="180"
                      Margin="16,0,4,0"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding AvailablePresets}"
                      DisplayMemberPath="Name"
                      ToolTip="{Binding SelectedItem.Description, RelativeSource={RelativeSource Self}}" />
            <Button Content="Apply Preset" Padding="6,2" Click="ApplyPresetButton_Click" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="HexRowsList"
                     Grid.Column="0"
                     ItemsSource="{Binding HexGrid.Rows}"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Item"
                     FontFamily="Consolas"
                     FontSize="13"
                     Margin="8"
                     BorderThickness="0"
                     Background="Transparent">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer>
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding OffsetText}" Width="80" />
                            <ItemsControl ItemsSource="{Binding HexBytes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Text, Mode=OneWay}"
                                                 Width="22"
                                                 MaxLength="2"
                                                 BorderThickness="0"
                                                 IsReadOnly="{Binding IsReadOnly}"
                                                 PreviewTextInput="HexCell_PreviewTextInput"
                                                 LostFocus="HexCell_LostFocus"
                                                 KeyDown="HexCell_KeyDown">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#553399FF" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                            <Setter Property="Background" Value="#FFFFC107" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding AsciiText}" Margin="12,0,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="LightGray" />

            <Grid Grid.Column="2" Margin="8">
                <Border BorderBrush="Gray" BorderThickness="1">
                    <Image Source="{Binding Preview.CurrentPreview}" Stretch="Uniform" />
                </Border>
                <Border Background="#CC330000"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        Padding="6,4"
                        Visibility="{Binding Preview.HasDecodeError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Can't decode current bytes — showing last good preview"
                               Foreground="White"
                               TextWrapping="Wrap"
                               FontSize="12" />
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
